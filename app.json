{
  "expo": {
    "name": "ZeroFoodWaste",
    "slug": "ZeroFoodWaste",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/images/icon.png",
    "scheme": "zerofoodwaste",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.zerofoodwaste.app",
      "adaptiveIcon": {
        "backgroundColor": "#176B42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#176B42",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#101D17",
            "image": "./assets/images/android-icon-foreground.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es"
            ],
            "android": [
              "en",
              "es"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan barcodes",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59260a20-c1a8-4f90-a148-082ac04a2dc8"
      }
    }
  }
}
